# ---- AI provider (OpenAI-compatible) ----
# The AI report/co-pilot works with ANY OpenAI-compatible endpoint.
# Just set the base URL + model + key for the provider you want.
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Examples (uncomment one):
#   OpenAI:     AI_BASE_URL=https://api.openai.com/v1          AI_MODEL=gpt-4o
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1       AI_MODEL=anthropic/claude-3.5-sonnet
#   Ollama:     AI_BASE_URL=http://localhost:11434/v1          AI_MODEL=llama3.1   (local & private, key can be anything)

# ---- Optional ----
# NVD API key (https://nvd.nist.gov/developers/request-an-api-key)
# Leave empty; if set, CVE query rate goes from 6s/request to ~0.7s/request.
NVD_API_KEY=
