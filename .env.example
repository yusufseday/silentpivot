# ---- AI provider (OpenAI-compatible) ----
# Set your API key. Works with any OpenAI-compatible provider — use whichever you want.
# For your provider, also set AI_BASE_URL + AI_MODEL (pick a line below).
AI_API_KEY=your_api_key_here

# Provider examples (uncomment + set both lines for the one you use):
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1     AI_MODEL=llama-3.3-70b-versatile
#   OpenAI:     AI_BASE_URL=https://api.openai.com/v1          AI_MODEL=gpt-4o
#   Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-2.0-flash
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1       AI_MODEL=anthropic/claude-3.5-sonnet
#   Ollama:     AI_BASE_URL=http://localhost:11434/v1          AI_MODEL=llama3.1   (local & private, key can be anything)

# ---- OPSEC (optional) ----
# Route all HTTP traffic through a proxy (Tor, Burp, proxychains, a VPS...).
# Can also be set from the panel: [O] OPSEC Profile. SOCKS needs: pip install 'requests[socks]'
SP_PROXY=

# ---- Optional ----
# NVD API key (https://nvd.nist.gov/developers/request-an-api-key)
# Leave empty; if set, CVE query rate goes from 6s/request to ~0.7s/request.
NVD_API_KEY=
